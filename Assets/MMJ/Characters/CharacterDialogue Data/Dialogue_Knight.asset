  m_Script: {fileID: 11500000, guid: 84b9ab0d0519fa140a46b637acf05898, type: 3}
  m_Name: Dialogue_Knight
  m_EditorClassIdentifier: Assembly-CSharp::CharacterDialogueData
  dialogues:
  - "\uB098\uB294 \uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uB294\uB2E4"
  - "\uBC29\uD328\uB294 \uC57D\uC790\uB97C \uD5A5\uD55C\uB2E4"
  - "\uC774 \uAC80\uC740 \uB9F9\uC138\uB2E4"
  - "\uB450\uB824\uC6C0\uC740 \uB118\uC5B4\uC124 \uB300\uC0C1\uC774\uB2E4"
  - "\uAE38\uC744 \uBE44\uCF1C\uB77C. \uB0B4\uAC00 \uC55E\uC5D0 \uC120\uB2E4"
  - "\uC815\uC758\uB294 \uC120\uD0DD\uC774 \uC544\uB2C8\uB2E4. \uC758\uBB34\uB2E4"
  - "\uC0C1\uCC98\uB294 \uBC84\uD168\uB0B8 \uC99D\uAC70"
  - "\uC4F0\uB7EC\uC9C0\uAE30 \uC804\uAE4C\uC9C4 \uD328\uBC30\uAC00 \uC544\uB2C8\uB2E4"
  - "\uB4A4\uB294 \uB9E1\uC544\uB77C"
  - "\uB0B4\uAC00 \uC11C \uC788\uB294 \uACF3\uC774 \uC804\uC120\uC774\uB2E4"
  - "\uBC29\uD328\uB97C \uB4E4\uC5B4\uB77C. \uC9C0\uAE08\uC774\uB2E4"
  - "\uC774 \uB9F9\uC138\uB294 \uD53C\uB85C \uC4F0\uC600\uB2E4"
  - "\uBE5B\uC740 \uACB0\uCF54 \uD63C\uC790 \uC624\uC9C0 \uC54A\uB294\uB2E4"
  - "\uC545\uC740 \uD56D\uC0C1 \uAC19\uC740 \uC5BC\uAD74\uC744 \uD558\uC9C0"
  - "\uAC80\uC740 \uD754\uB4E4\uB824\uB3C4 \uB9C8\uC74C\uC740 \uD754\uB4E4\uB9AC\uC9C0
    \uC54A\uB294\uB2E4"
  - "\uB3C4\uB9DD\uCE60 \uD544\uC694 \uC5C6\uB2E4. \uB0B4\uAC00 \uC788\uB2E4"
  - "\uC2EC\uD310\uC740 \uB0B4\uAC00 \uB9E1\uACA0\uB2E4"
  - "\uC5EC\uAE30\uC11C \uBA48\uCD98\uB2E4"
  - "\uC815\uC758\uB294 \uC870\uC6A9\uD788 \uB05D\uB0B4\uC9C0 \uC54A\uB294\uB2E4"
  - "\uC804\uC9C4"
  - "\uB9AC\uC790\uB4DC\uB294 \uC790\uC138\uD788 \uBCF4\uBA74 \uADC0\uC5EC\uC6CC"

  dialogues:
  - "\uC804\uD22C \uC2DC\uC2A4\uD15C \uC815\uC0C1 \uC791\uB3D9"
  - "\uBAA9\uD45C \uD655\uC778. \uC81C\uAC70 \uAC1C\uC2DC"
  - "\uAC10\uC815\uC740 \uC784\uBB34\uC5D0 \uBD88\uD544\uC694"
  - "\uBC29\uC5B4\uB9C9 80\uD37C\uC13C\uD2B8 \uC720\uC9C0"
  - "\uD6C4\uD1F4\uB294 \uC120\uD0DD\uC9C0\uC5D0 \uC5C6\uB2E4"
  - "\uC804\uC7A5\uC740 \uACC4\uC0B0\uC73C\uB85C"
  - "\uB124 \uC6C0\uC9C1\uC784, \uC608\uCE21 \uC644\uB8CC"
  - "\uD0C4\uC57D \uCDA9\uBD84. \uAC71\uC815 \uBD88\uD544\uC694"
  - "\uC774 \uC7A5\uBE44\uB294 \uB108\uBCF4\uB2E4 \uC624\uB798 \uC0B0\uB2E4"
  - "\uBA85\uB839\uC744 \uB0B4\uB824. \uC2E4\uD589"
  - "\uD53C\uD574 \uCD5C\uC18C\uD654, \uD6A8\uC728 \uCD5C\uB300\uD654"
  - "\uB09C \uC601\uC6C5\uC774 \uC544\uB2C8\uB2E4. \uBCD1\uC0AC"
  - "\uBBFC\uAC04\uC778\uC740 \uBCF4\uD638 \uB300\uC0C1"
  - "\uC774 \uB3C4\uC2DC\uB294 \uB0B4\uAC00 \uC9C0\uD0A8\uB2E4"
  - "\uAE30\uC220\uC740 \uBC30\uC2E0\uD558\uC9C0 \uC54A\uB294\uB2E4"
  - "\uC784\uBB34 \uC2E4\uD328\uB294 \uC5C6\uB2E4"
  - "\uC800\uB141\uC2DD\uC0AC \uC791\uC804 \uC885\uB8CC\uAE4C\uC9C0 10\uCD08"
  - "\uBAA9\uD45C \uBB34\uB825\uD654. \uB2E4\uC74C \uB2E8\uACC4"

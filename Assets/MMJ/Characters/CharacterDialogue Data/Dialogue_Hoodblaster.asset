--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84b9ab0d0519fa140a46b637acf05898, type: 3}
  m_Name: Dialogue_Hoodblaster
  m_EditorClassIdentifier: Assembly-CSharp::CharacterDialogueData
  dialogues:
  - "\uC88B\uC544\u2026 \uC218\uCE58\uAC00 \uC644\uBCBD\uD574~~!"
  - "\uB8EC \uCD9C\uB825, \uC815\uC0C1! \uC544\uC8FC \uC815\uC0C1! \uC0B4\uC9DD \uB118\uC5B4\uAC14\uB2E4\uACE0?
    \uC774\uAC8C \uC815\uC0C1\uC774\uC57C!"
  - "\uD3ED\uBC1C\uC740 \uC2E4\uD328\uAC00 \uC544\uB2C8\uB2E4. \uACFC\uC815\uC774\uB2E4.
    \uBC84\uBE14\uBA54\uC774\uCEE4\uB3C4 \uADF8\uB7EC\uB358\uB370?"
  - "\uC774 \uC7A5\uBE44? \uC544\uC9C1 63\uD37C\uC57C \uCDA9\uC804\uD574\uC904 \uC218
    \uC5C6\uC5B4? \uC544\uC2A4\uD2B8\uB85C\uBE14\uB798\uC2A4\uD130?"
  - "\uC544\uC2A4\uD2B8\uB85C \uBE14\uB798\uC2A4\uD130\uB791\uC740 \uBE14\uB798\uC2A4\uD130
    \uCE5C\uAD6C\uC778\uC148\uC774\uC57C. \uAC58 \uB098\uB97C \uC2EB\uC5B4\uD558\uC9C0\uB9CC"
  - "\uB4A4\uB85C \uC11C. \uC2E4\uD5D8 \uC911\uC774\uB2C8\uAE4C. \uC544\uB2D8...
    \uC544\uC608 \uC55E\uC73C\uB85C \uAC00\uBCF4\uB358\uAC00"
  - "\uB9C8\uBC95\uACFC \uAE30\uACC4\uB294 \uC2F8\uC6B0\uC9C0 \uC54A\uC544, \uC6B0\uB9AC
    \uC5C4\uB9C8\uB791 \uC544\uBE60\uB294 \uC2F8\uC6CC\uB3C4"
  - "\uB0B4\uAC00 \uC5B5\uC9C0\uB85C \uD654\uD574\uC2DC\uD0AC \uBFD0\uC774\uC9C0"
  - "\uD55C \uBC88 \uB354 \uC3D8\uBA74\u2026 \uC544, \uB9DD\uAC00\uC9C8 \uC218\uB3C4..
    \uBB3C\uB860 \uBE14\uB798\uC2A4\uD130 \uB9D0\uACE0 \uC801\uC774!"
  - "\uAE30\uB85D\uD574 \uB46C. \uC774\uAC74 \uC5ED\uC0AC\uC57C!!"
  - "\uC5F0\uAE30? \uC774\uAC8C \uC815\uC0C1 \uBC18\uC751\uC774\uC57C. \uAC81\uBA39\uC5C8\uB2C8?"
  - "\uACC4\uC0B0\uC740 \uB05D\uB0AC\uC5B4. \uC544\uB9C8\uB3C4...?"
  - "\uC774 \uC18C\uB9AC \uB4E4\uB824? \uC131\uACF5\uC758 \uC9C4\uB3D9\uC774\uC57C.
    \uC544\uB2D8 \uBE14\uB798\uC774\uB4DC\uB304\uC11C\uC758 \uCF54\uACE8\uC774\uB358\uAC00"
  - "\uC774 \uC18C\uB9AC \uB4E4\uB824? \uC131\uACF5\uC758 \uC9C4\uB3D9\uC774\uC57C"
  - "\uBA48\uCD94\uB77C\uACE0? \uC65C? \uC798 \uB3CC\uC544\uAC00\uB294\uB370"
  - "\uB8EC\uC774 \uBE44\uBA85\uC744 \uC9C0\uB974\uB124. \uD765\uBBF8\uB85C\uC6CC"
  - "\uC774 \uC815\uB3C4 \uC704\uD5D8\uC740 \uAC10\uC218\uD574\uC57C\uC9C0"
  - "\uC2E4\uD328 \uD655\uB960 12\uD37C. \uAD1C\uCC2E\uC544 \uC544 \uB0B4\uAC00 \uC2E4\uD328\uD655\uB960\uC774\uB77C
    \uADF8\uB7AC\uB098? \uC131\uACF5\uD655\uB960\uC774 12\uD37C\uB77C\uACE0~"
  - "\uB098\uB9CC \uBBFF\uC5B4. \uC544\uB2C8, \uC7A5\uBE44\uB97C \uBBFF\uC5B4"
  - "\uD130\uC9C0\uBA74 \uB3C4\uB9DD\uCCD0"
  - "\uB2E4\uC2DC \uB9D0\uD558\uC9C0\uB9CC, \uAC70\uC758 \uC644\uBCBD\uD574"
  - "\uC790, \uB2E4\uC74C \uC2E4\uD5D8\uC774\uB2E4!"

  m_Script: {fileID: 11500000, guid: 84b9ab0d0519fa140a46b637acf05898, type: 3}
  m_Name: Dialogue_Assassin
  m_EditorClassIdentifier: Assembly-CSharp::CharacterDialogueData
  dialogues:
  - "\uB10C \uC774\uBBF8 \uB0B4 \uC0AC\uC815\uAC70\uB9AC \uC548\uC774\uB2E4"
  - "\uACBD\uACE0\uD558\uC9C0 \uC54A\uB294\uB2E4"
  - "\uB3C4\uB9DD\uCE60 \uC0DD\uAC01\uC740 \uBC84\uB824\uB77C"
  - "\uCE7C\uC740 \uB450 \uAC1C\uBA74 \uCDA9\uBD84\uD558\uB2E4"
  - "\uB05D\uC740 \uBE60\uB97C\uC218\uB85D \uC790\uBE44\uB2E4"
  - "\uB0A0 \uBD24\uB2E4\uB294 \uAC8C \uB124 \uB9C8\uC9C0\uB9C9 \uC2E4\uC218\uB2E4"
  - "\uC18C\uB9AC\uB294 \uC8FD\uC740 \uB4A4\uC5D0 \uB4E4\uB824"
  - "\uB0B4 \uC774\uB984\uC744 \uBB3B\uC9C0 \uB9C8\uB77C. \uC18C\uC6A9\uC5C6\uC744\uD14C\uB2C8"
  - "\uCC30\uB098\u2014 \uADF8\uAC8C \uB124 \uC804\uBD80\uB2E4"
  - "\uD6C4\uD68C\uD560 \uC2DC\uAC04\uB3C4 \uC5C6\uC744 \uAC70\uB2E4"
  - "\uBE44\uBA85\uC740 \uAE30\uB85D\uC5D0 \uB0A8\uC9C0 \uC54A\uB294\uB2E4"
  - "\uB0B4\uAC00 \uC6C0\uC9C1\uC774\uBA74, \uB204\uAD70\uAC00\uB294 \uC4F0\uB7EC\uC9C4\uB2E4"
  - "\uBA85\uB839\uC740 \uD558\uB098. \uC81C\uAC70"
  - "\uD53C\uD560 \uC218 \uC5C6\uB2E4\uBA74\u2026 \uBC1B\uC544\uB4E4\uC5EC\uB77C"
  - "\uD53C\uD560 \uC218 \uC5C6\uB2E4\uBA74\u2026 \uBC1B\uC544\uB4E4\uC5EC\uB77C"
  - "\uB0B4\uCE7C\uC740 \uD56D\uC0C1 \uBAA9\uD45C\uB97C \uCC3E\uB294\uB2E4"
  - "\uC0B4\uC544\uB0A8\uACE0 \uC2F6\uB2E4\uBA74 \uB208\uC744 \uAC10\uC544\uB77C"
  - "\uC774\uAC74 \uC2F8\uC6C0\uC774 \uC544\uB2C8\uB2E4. \uC9D1\uD589\uC774\uB2E4"
  - "\uB2E4\uC74C \uBAA9\uD45C\uB294\u2026 \uB108\uB2E4"

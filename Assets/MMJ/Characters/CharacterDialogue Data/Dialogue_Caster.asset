  m_Script: {fileID: 11500000, guid: 84b9ab0d0519fa140a46b637acf05898, type: 3}
  m_Name: Dialogue_Caster
  m_EditorClassIdentifier: Assembly-CSharp::CharacterDialogueData
  dialogues:
  - "\uBD88\uAF43\uC740 \uAC70\uC9D3\uB9D0\uC744 \uC548 \uD574"
  - "\uAC00\uAE4C\uC774 \uC640\uB3C4 \uB3FC\u2026 \uD0C8 \uBFD0\uC774\uB2C8\uAE4C"
  - "\uB124 \uACF5\uD3EC, \uC544\uC8FC \uC798 \uD0C0\uB124"
  - "\uB9C8\uACC4\uC758 \uBD88\uC740 \uAEBC\uC9C0\uC9C0 \uC54A\uC544"
  - "\uB3C4\uB9DD\uCE58\uBA74 \uB354 \uC544\uD30C\uC9C8\uAC78?"
  - "\uC774 \uD798, \uAC10\uB2F9\uD560 \uC790\uC2E0 \uC788\uC5B4?"
  - "\uACC4\uC57D\uC11C\uB294 \uC774\uBBF8 \uC368\uC84C\uC5B4. \uC885\uC2E0\uD615\uC73C\uB85C!"
  - "\uBD88\uC740 \uC815\uC9C1\uD574. \uB2E4 \uD0DC\uC6CC\uBC84\uB9AC\uAC70\uB4E0"
  - "\uB0A0 \uB450\uB824\uC6CC\uD558\uB294 \uD45C\uC815, \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4.
    \uBF40\uBF40\uD574\uC904\uAE4C?"
  - "\uC18C\uB9AC \uC9C8\uB7EC\uB3C4 \uB3FC. \uC5B4\uBA38\uB098 \uADC0\uC5FD\uB124~"
  - "\uB9C8\uBC95? \uC544\uB2C8, \uBCF8\uB2A5\uC774\uC57C"
  - "\uB05D\uAE4C\uC9C0 \uD0C0\uC624\uB974\uB294 \uAC8C \uC608\uC758\uC9C0. \uC0AC\uB791\uC774\uACE0
    \uB9D0\uC774\uC57C"
  - "\uC7AC\uAC00 \uB418\uBA74 \uB2E4 \uAC19\uC544\uC838"
  - "\uB10C \uC774\uBBF8 \uB0B4 \uC628\uB3C4\uC57C"
  - "\uB10C \uC774\uBBF8 \uB0B4 \uC628\uB3C4\uC57C"
  - "\uC544\uC9C1 \uC0B4\uC544 \uC788\uC5B4? \uC758\uC678\uB124 \uAF2C\uC625 \uC548\uC544\uC904\uAC8C~"
  - "\uB2E4\uC74C\uC5D4 \uB354 \uB728\uAC81\uAC8C \uD574\uC904\uAC8C"
  - "\uAEBC\uC9C8\uAE4C \uBD10 \uAC71\uC815\uB3FC? \uAC71\uC815 \uB9C8"
  - "\uB09C\u2026 \uBD88 \uADF8 \uC790\uCCB4\uB2C8\uAE4C"

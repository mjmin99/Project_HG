  m_Script: {fileID: 11500000, guid: 84b9ab0d0519fa140a46b637acf05898, type: 3}
  m_Name: Dialogue_Witch
  m_EditorClassIdentifier: Assembly-CSharp::CharacterDialogueData
  dialogues:
  - "\uB9C8\uBC95\uC740 \uBA85\uB839\uC774\uC57C\u2026 \uAC10\uC815\uC740, \uC74C\u2026
    \uC608\uC678\uC9C0"
  - "\uC624\uD574\uD558\uC9C0 \uB9C8. \uD2B9\uBCC4\uD55C \uAC74 \uC544\uB2C8\uC57C"
  - "\uC57D\uD574\uC9C0\uB294 \uAC74 \uC2EB\uC5B4. \uADF8\uB7F0\uB370 \uAD81\uAE08\uD574"
  - "\uC9C0\uAE08 \uC5BC\uAD74 \uBD89\uC5B4\uC9C4 \uAC70? \uBD88\uAF43 \uB54C\uBB38\uC774\uC57C"
  - "\uC5F0\uC778\uC740 \uC804\uBD80 \uBE44\uADF9\uC73C\uB85C \uB05D\uB09C\uB2E4\uB354\uAD70"
  - "\uB9C8\uB825\uC740 \uAC70\uC9D3\uB9D0\uC744 \uC2EB\uC5B4\uD558\uC9C0"
  - "\uB0B4\uAC00 \uB110 \uC9C0\uCF1C\uBCF8\uB2E4\uACE0 \uD574\uC11C \uC758\uBBF8\uB294
    \uC5C6\uC5B4"
  - "\uC0AC\uB791\uC740 \uC704\uD5D8\uD574. \uB098\uD55C\uD14C \uD2B9\uD788"
  - "\uADF8\uB798\uB3C4, \uBD88\uC744 \uAEBC\uC57C \uD560 \uB54C\uB294 \uC54C\uC544"
  - "\uB05D\uAE4C\uC9C0 \uBD10\uB77C. \uC544\uB984\uB2E4\uC6B0\uB2C8\uAE4C"
  - "\uB9C8\uBC95\uC0AC\uB294 \uC0B4\uC544\uB0A8\uC740 \uC790\uC57C"
  - "\u2026\uADFC\uB370 \uC65C \uCC45\uC5D4 \uD56D\uC0C1 \uC0AC\uB791\uC774 \uB098\uC624\uC9C0?"
  - "\uBD88\uAF43\uC740 \uBAA8\uB450 \uD0DC\uC6B0\uC9C0\uB9CC\u2026 \uC5B4\uB5A4
    \uAC74 \uB0A8\uACA8\uB450\uACE0 \uC2F6\uC5B4"
  - "\uB124 \uC2EC\uC7A5 \uBC15\uB3D9, \uC774\uC0C1\uD558\uAC8C \uAC70\uC2AC\uB9AC\uB124"
  - "\uCC29\uAC01\uD558\uC9C0 \uB9C8. \uC774\uAC74 \uD638\uAE30\uC2EC\uC77C \uBFD0\uC774\uC57C"
  - "\uC0AC\uB791? \uC4F8\uBAA8\uC5C6\uB294 \uAC10\uC815\uC774\uB77C\uACE0 \uBC30\uC6E0\uC5B4"

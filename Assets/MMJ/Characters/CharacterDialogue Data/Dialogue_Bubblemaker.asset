  m_Script: {fileID: 11500000, guid: 84b9ab0d0519fa140a46b637acf05898, type: 3}
  m_Name: Dialogue_Bubblemaker
  m_EditorClassIdentifier: Assembly-CSharp::CharacterDialogueData
  dialogues:
  - "\uB108\uD76C\uC758 \uC2DC\uAC04\uC740 \uCC38\uC73C\uB85C \uC9E7\uAD6C\uB098.
    \uAC70\uD488\uCC98\uB7FC\uB9D0\uC774\uC9C0"
  - "\uB098\uB294 \uD0C4\uC0DD\uB3C4, \uC8FD\uC74C\uB3C4 \uC544\uB2C8\uB2E4. \uAC70\uD488...
    \uC774\uB784\uAE4C?"
  - "\uBCC4\uC758 \uC228\uACB0\uC774 \uB098\uB97C \uBD80\uB978\uB2E4"
  - "\uC774\uB984\uC740 \uC758\uBBF8 \uC5C6\uB2E4. \uAC70\uD488\uB9CC\uC774 \uC874\uC7AC\uD558\uC9C0!"
  - "\uACF5\uAC04\uC774\u2026 \uB178\uB798\uD558\uACE0 \uC788\uC5B4"
  - "\uC774 \uCC28\uC6D0\uC740 \uACE7 \uBD95\uAD34\uD55C\uB2E4. \uC774 \uB610\uD55C
    \uAC70\uD488\uCC98\uB7FC \uB9D0\uC774\uC9C0!"
  - "\uC120\uD0DD\uD558\uB77C. \uAD00\uCE21\uC790\uAC00 \uB420\uC9C0, \uAC70\uD488\uC774
    \uB420\uC9C0.."
  - "\uAC70\uD488\uC758 \uAC10\uC815\uC740 \uC5D0\uB108\uC9C0\uC758 \uD30C\uD3B8\uC774\uB2E4"
  - "\uB098\uB294 \uD750\uB984\uC744 \uBC14\uB85C\uC7A1\uC744 \uBFD0"
  - "\uB108\uD76C\uC758 \uC804\uC7C1\uC740 \uB108\uBB34 \uC2DC\uB044\uB7FD\uB2E4.
    \uD130\uC9C0\uB294 \uAC70\uD488 \uCC98\uB7FC \uB9D0\uC774\uC9C0"
  - "\uBC14\uB78C \uC18D\uC5D0\uC11C\uB9CC \uAC70\uD488\uC774 \uD0DC\uC5B4\uB09C\uB2E4"
  - "\uBC14\uB78C \uC18D\uC5D0\uC11C\uB9CC \uAC70\uD488\uC774 \uD0DC\uC5B4\uB09C\uB2E4"
  - "\uBCC4\uC740 \uB298 \uB108\uD76C\uB97C \uB0B4\uB824\uB2E4\uBD24\uB2E4"
  - "\uAC70\uD488\uC744 \uC774\uD574\uD558\uC9C0 \uBABB\uD574\uB3C4 \uAD1C\uCC2E\uB2E4"
  - "\uC774\uAC83\uC774 \uB05D\uC774 \uC544\uB2C8\uB2E4. \uBCC0\uD615\uC774\uB2E4"
  - "\uC6B0\uC8FC\uB294 \uC9C8\uBB38\uD558\uC9C0 \uC54A\uB294\uB2E4. \uBC18\uC751\uD560
    \uBFD0"
  - "\uB108\uB294 \uC544\uC9C1 \uAC70\uD488\uB428\uC758 \uAC00\uB2A5\uC131\uC774\uB2E4"
  - "\uAC70\uD488\uC740 \uD130\uC9C0\uAE30 \uC9C1\uC804\uC774 \uAC00\uC7A5 \uC544\uB984\uB2F5\uC9C0"
  - "\uB098\uB97C \uBD80\uB974\uC9C0 \uB9C8\uB77C. \uC774\uBBF8 \uC640 \uC788\uB2E4"
  - "\uB098\uB97C \uBD80\uB974\uC9C0 \uB9C8\uB77C. \uC774\uBBF8 \uC640 \uC788\uB2E4"
  - "\uAD00\uCE21 \uC644\uB8CC. \uB2E4\uC74C \uC21C\uD658\uC73C\uB85C"
  - "\uAC70\uD488\uC740.. \uC608\uC220\uC774\uB2E4!"

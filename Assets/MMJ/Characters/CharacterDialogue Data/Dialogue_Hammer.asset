  m_Script: {fileID: 11500000, guid: 84b9ab0d0519fa140a46b637acf05898, type: 3}
  m_Name: Dialogue_Hammer
  m_EditorClassIdentifier: Assembly-CSharp::CharacterDialogueData
  dialogues:
  - "\uC774 \uB9DD\uCE58\uB294 \uAC70\uD488\uBCF4\uB2E4 \uC624\uB798\uB410\uB2E4...\uACE0
    \uBC84\uBE14\uBA54\uC774\uCEE4\uAC00 \uB9D0\uD558\uB358\uB370 \uB09C \uC798\uBAB0\uB77C"
  - "\uB9DD\uCE58\uB294 \uB9DD\uCE58\uC77C\uB54C \uB2E4\uB978\uAC78 \uB9DD\uCE60\uBFD0...
    (\uD489\uD0A5)"
  - "\uB8EC\uC774 \uC6B8\uB9AC\uBA74, \uB545\uC774 \uB300\uB2F5\uD558\uC9C0"
  - "\uC2E0\uC758 \uD798? \uBE4C\uB9B0 \uC801 \uC5C6\uB2E4 \uADF8\uAC8C \uB0B4\uAC00
    \uD1A0\uB974\uBCF4\uB2E4 \uB098\uC740\uC810\uC774\uC9C0"
  - "\uBB34\uAC8C\uB97C \uACAC\uB38C\uB77C. \uADF8\uAC8C \uC2E0\uB150\uC774\uB2E4"
  - "\uBD80\uC11C\uC9C4 \uAE30\uB465\uB3C4 \uCC98\uC74C\uC5D4 \uC2E0\uC559\uC774\uC5C8\uB2E4"
  - "\uCE68\uBB35\uD574\uB77C. \uCDA9\uC804 \uC911\uC774\uB2E4"
  - "\uB9DD\uCE58\uAC00 \uB5A8\uC5B4\uC9C0\uBA74 \uB05D\uC774\uB2E4"
  - "\uAE30\uB3C4\uB294 \uC0AC\uD6C4\uC5D0 \uD574\uB77C"
  - "\uB545\uC774 \uAC08\uB77C\uC9C0\uB294 \uC774\uC720\uB97C \uC54C\uB824\uC8FC\uC9C0"
  - "\uC2E0\uC804\uC740 \uBB34\uB108\uC838\uB3C4 \uD798\uC740 \uB0A8\uB294\uB2E4"
  - "\uB9DD\uC124\uC784\uC740 \uC190\uC744 \uC57D\uD558\uAC8C \uB9CC\uB4E0\uB2E4"
  - "\uB098\uB3C4 \uC62C\uB4DC\uBCF4\uC774 \uC7AC\uBBF8\uC788\uAC8C \uBD24\uB2E4.
    \uBB3C\uB860 \uB9DD\uCE58\uB294 \uB0B4\uAC00 \uB354 \uC798\uC4F0\uC9C0\uB9CC"
  - "\uBE14\uB808\uC774\uB4DC\uB304\uC11C\uB294 \uC798\uB54C \uCF54\uB97C \uB108\uBB34
    \uACE8\uC544"
  - "QWER \uC608\uC058\uB354\uB77C \uD788\uB098\uC778\uAC00 \uAC54\uAC00 \uD2B9\uD788"
  - "\uB098\uB294 \uC778\uAC04\uC774 \uC544\uB2C8\uB2E4. \uCE74\uBBF8\uC0AC\uB9C8\uB2E4..."

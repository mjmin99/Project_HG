  m_Script: {fileID: 11500000, guid: 84b9ab0d0519fa140a46b637acf05898, type: 3}
  m_Name: Dialogue_Bladedancer
  m_EditorClassIdentifier: Assembly-CSharp::CharacterDialogueData
  dialogues:
  - "\uD558\uD558! \uC801\uB4E4\uC740 \uC624\uB298\uB3C4 \uC2DC\uB044\uB7FD\uAD70!"
  - "\uAC80\uACFC \uCD1D, \uB458 \uB2E4 \uC798 \uC368\uC57C \uC0B4\uC544\uB0A8\uC9C0"
  - "\uAC81\uBA39\uC5C8\uB098?"
  - "\uC774 \uD749\uD130? \uAC12\uC9C4 \uAC70\uB798\uC600\uC9C0"
  - "\uC220 \uD55C\uC794\uD560 \uC2DC\uAC04\uC740 \uB0A8\uACA8\uB46C\uB77C"
  - "\uC57D\uC18D\uC740 \uAF2D \uC9C0\uD0A8\uB2E4. \uD574\uC801\uC774\uB77C\uB3C4
    \uB9D0\uC774\uC57C"
  - "\uBC30\uC2E0\uD574\uB3C4 \uB3D9\uB8CC\uB294 \uC548 \uBC84\uB824"
  - "\uB124 \uBCF4\uBB3C, \uB0B4\uAC00 \uC7A0\uC2DC \uB9E1\uC9C0"
  - "\uCD1D\uC54C\uC740 \uC5B4... \uADF8\uB7EC\uB2C8\uAE4C....\uC778\uC0AC \uAC19\uC740
    \uAC70\uC9C0"
  - "\uCE7C\uBD80\uB9BC\uC740 \uC815\uC9C1\uD574\uC11C \uC88B\uC544"
  - "\uD3ED\uD48D? \uC624\uD788\uB824 \uC2E0\uB098\uB294\uB370!"
  - "\uB0B4\uAC00 \uBC95\uC774\uB2E4"
  - "\uB05D\uB098\uACE0 \uC220 \uC0AC\uB77C. \uC0B4\uC558\uC73C\uBA74 \uB9D0\uC774\uC57C"
  - "\uADF8 \uB208\uBE5B\u2026 \uC2F8\uC6B8 \uC904 \uC544\uB294 \uB188\uC774\uAD70"
  - "\uB298 \uC120\uD0DD\uC744 \uC694\uAD6C\uD558\uC9C0"
  - "\uB124 \uC6B4, \uC624\uB298 \uAF64 \uC548 \uC88B\uB2E4"
  - "\uB098\uB97C \uB9CC\uB09C \uC21C\uAC04 \uB124 \uC6B4\uBA85\uC740 \uC815\uD574\uC84C\uC5B4"

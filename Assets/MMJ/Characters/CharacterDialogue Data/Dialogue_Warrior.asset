  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84b9ab0d0519fa140a46b637acf05898, type: 3}
  m_Name: Dialogue_Warrior
  m_EditorClassIdentifier: Assembly-CSharp::CharacterDialogueData
  dialogues:
  - "\uC5B4\uC774\uCFE0, \uD45C\uC815\uC774 \uC65C \uADF8\uB798?"
  - "\uAC71\uC815 \uB9C8, \uC548 \uC544\uD504\uAC8C \uB05D\uB0B4\uC904\uAC8C. \uC544\uB9C8\uB3C4."
  - "\uC774 \uAC80? \uBA4B\uC788\uC9C0. \uC131\uB2A5\uB3C4 \uC88B\uACE0. \uAC15\uC5D0\uC11C
    \uC8FC\uC6E0\uC5B4"
  - "\uC2F8\uC6B0\uAE30 \uC804\uC5D0 \uC774\uB984\uBD80\uD130 \uBB3C\uC744\uAE4C?
    \uC544\uB2C8 \uB108 \uB9D0\uACE0 \uB124 \uAC80 \uB9D0\uC774\uC57C"
  - "\uC84C\uB2E4\uACE0 \uC6B8\uC9C4 \uB9D0\uACE0 \uC57D\uD574\uBCF4\uC774\uC796\uC544"
  - "\uAF2C\uB9AC \uC7A1\uC9C0 \uB9C8. \uC9C4\uC9DC \uC2EB\uC5B4"
  - "\uC9C4\uC9C0\uD55C \uC5BC\uAD74\uC5D4 \uB0B4\uAC00 \uC57D\uD574. \uC6C3\uACA8\uC11C"
  - "\uAE34\uC7A5 \uD480\uC5B4. \uC190 \uB5A8\uB9AC\uC796\uC544"
  - "\uBC29\uAE08 \uADF8\uAC74 \uC5F0\uC2B5\uC774\uC5C8\uC5B4"
  - "\uC544\uC9C1\uB3C4 \uC11C \uC788\uB124? \uC758\uC678\uB2E4. \uC544\uB2C8 \uB108
    \uB9D0\uACE0 \uB124..."
  - "\uC18D\uC784\uC218\uB3C4 \uC2E4\uB825\uC774\uC9C0"
  - "\uC774\uAC70 \uB05D\uB098\uACE0 \uBC25 \uC0AC\uB77C \uADF8\uB7FC \uC548 \uC8FD\uC77C\uAC8C"
  - "\uB4A4\uC5D0\uC11C \uC624\uB294 \uAC74 \uAE30\uBCF8\uC774\uC57C"
  - "\uB208 \uD06C\uAC8C \uB5A0. \uB9C8\uC9C0\uB9C9 \uC7A5\uBA74\uC774\uC57C"
  - "\uC5B4? \uBC29\uAE08 \uBB50 \uC783\uC5B4\uBC84\uB838\uC5B4"
  - "\uC2F8\uC6C0\uC740 \uC7AC\uBC0C\uC5B4\uC57C\uC9C0"
  - "\uD654\uB0B4\uC9C0 \uB9C8, \uC8FC\uB984 \uC0DD\uACA8"
  - "\uC84C\uC73C\uBA74 \uC84C\uB2E4\uACE0 \uC778\uC815\uD574"
  - "\uC790, \uB2E4\uC2DC \uD560\uAE4C?"
  - "\uB098\uC774\uD2B8\uB294 \uB108\uBB34 \uACE0\uC9C0\uC2DD\uD558\uB2E4\uB2C8\uAE50"

  m_Script: {fileID: 11500000, guid: 84b9ab0d0519fa140a46b637acf05898, type: 3}
  m_Name: Dialogue_Firecaster
  m_EditorClassIdentifier: Assembly-CSharp::CharacterDialogueData
  dialogues:
  - "\uB9C8\uBC95\uC740 \uAC10\uC815\uC774 \uC544\uB2C8\uB77C \uACC4\uC0B0\uC774\uB2E4"
  - "\uB8EC \uD558\uB098\uC758 \uC624\uCC28\uAC00 \uC8FD\uC74C\uC744 \uBD80\uB974\uC9C0"
  - "\uB124\uAC00 \uBCF4\uB294 \uAC74 \uB9C8\uBC95\uC774 \uC544\uB2C8\uB77C \uACF5\uC2DD\uC758
    \uACB0\uACFC\uB2E4"
  - "\uD798\uC744 \uC6D0\uD55C\uB2E4\uBA74 \uBA3C\uC800 \uC774\uD574\uD574\uB77C"
  - "\uB300\uC11C\uACE0\uC758 \uC9C0\uC2DD\uC740 \uB124\uAC00 \uAC10\uB2F9\uD560
    \uC218 \uC5C6\uC5B4"
  - "\uAC10\uD0C4\uC740 \uB098\uC911\uC5D0 \uD574\uB77C, \uC544\uC9C1 \uB05D\uB098\uC9C0
    \uC54A\uC558\uB2E4"
  - "\uB8EC\uC740 \uAC70\uC9D3\uB9D0\uC744 \uD558\uC9C0 \uC54A\uB294\uB2E4"
  - "\uC2E4\uD5D8\uC740 \uD56D\uC0C1 \uD76C\uC0DD\uC744 \uC694\uAD6C\uD558\uC9C0"
  - "\uB0B4\uAC00 \uD2C0\uB838\uB2E4\uBA74\u2026 \uC138\uACC4\uAC00 \uD2C0\uB9B0
    \uAC70\uB2E4"
  - "\uB9C8\uBC95\uC0AC\uB294 \uAC15\uD55C \uC790\uAC00 \uC544\uB2C8\uB77C \uC815\uD655\uD55C
    \uC790\uB2E4"
  - "\uC190 \uB5BC\uB77C, \uADF8\uAC74 \uBD09\uC778\uB41C \uBB38\uC591\uC774\uB2E4"
  - "\uC774 \uC815\uB3C4 \uB9C8\uB825\uC73C\uB85C \uB0A0 \uC0C1\uB300\uD558\uACA0\uB2E4\uACE0?"
  - "\uAE30\uB85D\uD574 \uB46C\uB77C. \uB2E4\uC2DC\uB294 \uC7AC\uD604\uD558\uC9C0
    \uBABB\uD560 \uD14C\uB2C8"
  - "\uD63C\uB3C8\uB3C4 \uBD84\uC11D\uD558\uBA74 \uC9C8\uC11C\uAC00 \uB41C\uB2E4"
  - "\uC2E4\uD328? \uADF8\uAC74 \uB370\uC774\uD130\uB2E4"
  - "\uC11C\uB450\uB974\uC9C0 \uB9C8\uB77C. \uC9C4\uB9AC\uB294 \uB3C4\uB9DD\uCE58\uC9C0
    \uC54A\uB294\uB2E4"
  - "\uC774\uC81C\u2026 \uACF5\uC2DD\uC744 \uC644\uC131\uD560 \uC2DC\uAC04\uC774\uB2E4"
  - "\uBB34\uBAA8\uD568\uC740 \uC7AC\uB2A5\uC744 \uC7A1\uC544\uBA39\uB294\uB2E4"

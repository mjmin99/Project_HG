  m_Script: {fileID: 11500000, guid: 84b9ab0d0519fa140a46b637acf05898, type: 3}
  m_Name: Dialogue_Lizard
  m_EditorClassIdentifier: Assembly-CSharp::CharacterDialogueData
  dialogues:
  - "\uB098\uB294 \uD608\uD1B5 \uADF8 \uC790\uCCB4\uB2E4"
  - "\uC6A9\uC758 \uC774\uB984\uC73C\uB85C"
  - "\uBC29\uD328\uB294 \uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uB294\uB2E4. \uB77C\uACE0
    \uB098\uC774\uD2B8\uAC00 \uADF8\uB7EC\uB358\uB370 \uB0B4 \uBC29\uD328\uB294 \uACF5\uACA9\uC6A9\uC774\uAC70\uB4E0
    \uCEA1X \uB204\uAD6C\uC528 \uCC98\uB7FC"
  - "\uB108\uC758 \uC6A9\uAE30\uB97C \uBCF8\uB2E4"
  - "\uD53C\uB294 \uB728\uAC81\uACE0, \uC758\uC9C0\uB294 \uB2E8\uB2E8\uD558\uB2E4
    \uB9C8\uCE58..."
  - "\uB098\uC758 \uC870\uC0C1\uB4E4\uC774 \uBCF4\uACE0 \uC788\uB2E4"
  - "\uC2F8\uC6C0\uC740 \uBA85\uC608\uB86D\uAC8C \uB05D\uB09C\uB2E4"
  - "\uBE44\uB298\uC740 \uAC70\uC9D3\uC744 \uD5C8\uC6A9\uD558\uC9C0 \uC54A\uB294\uB2E4"
  - "\uB124\uAC00 \uC99D\uBA85\uD574\uB77C. \uC790\uACA9\uC744"
  - "\uC6A9\uC740 \uC774\uC720 \uC5C6\uC774 \uBD84\uB178\uD558\uC9C0 \uC54A\uB294\uB2E4.
    \uADFC\uB370 \uB098\uB294 \uC6A9\uC774 \uC544\uB2C8\uAC70\uB4E0"
  - "\uB098\uC758 \uAF2C\uB9AC\uB294 \uB04A\uC5B4\uC9C0\uB294\uAC8C \uC544\uB2C8\uB77C\uACE0.
    \uB09C \uB3C4\uB9C8\uBC40\uC774 \uC544\uB2C8\uAC70\uB4E0?"
  - "\uB0B4\uAC00 \uB9C8\uC9C0\uB9C9 \uAD00\uBB38\uC774\uB2E4"
  - "\uC5EC\uAE30\uC11C \uB354\uB294 \uBABB \uAC04\uB2E4"
